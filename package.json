{
  "name": "zp-monitor-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target bun --outdir dist",
    "dev": "bun run --watch src/index.ts",
    "lint": "biome check .",
    "smoke": "bun run src/smoke.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/adk": "^1.4.0",
    "@google/genai": "^2.13.0",
    "@napi-rs/canvas": "^1.0.2",
    "@sinclair/typebox": "0.34.52",
    "elysia": "^1.4.29",
    "gamedig": "^5.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "latest",
    "@types/gamedig": "^5.0.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
